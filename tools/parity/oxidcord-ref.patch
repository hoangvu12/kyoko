+}
+
+fn hover(cx: &mut AsyncWindowContext, position: Point<Pixels>) -> anyhow::Result<()> {
+	cx.update(|window, cx| {
+		window.dispatch_event(
+			PlatformInput::MouseMove(MouseMoveEvent {
+				position,
+				pressed_button: None,
+				modifiers: Modifiers::default(),
+			}),
+			cx,
+		);
+	})
+}
+
+fn scroll(cx: &mut AsyncWindowContext, position: Point<Pixels>, distance: f32) -> anyhow::Result<()> {
+	cx.update(|window, cx| {
+		window.dispatch_event(
+			PlatformInput::MouseMove(MouseMoveEvent {
+				position,
+				pressed_button: None,
+				modifiers: Modifiers::default(),
+			}),
+			cx,
+		);
+		window.dispatch_event(
+			PlatformInput::ScrollWheel(ScrollWheelEvent {
+				position,
+				delta: ScrollDelta::Pixels(point(px(0.), px(-distance))),
+				modifiers: Modifiers::default(),
+				touch_phase: TouchPhase::Moved,
+			}),
+			cx,
+		);
+	})
+}
+
+fn click(cx: &mut AsyncWindowContext, position: Point<Pixels>, button: MouseButton) -> anyhow::Result<()> {
+	cx.update(|window, cx| {
+		window.dispatch_event(
+			PlatformInput::MouseDown(MouseDownEvent {
+				button,
+				position,
+				modifiers: Modifiers::default(),
+				click_count: 1,
+				first_mouse: false,
+			}),
+			cx,
+		);
+		window.dispatch_event(
+			PlatformInput::MouseUp(MouseUpEvent {
+				button,
+				position,
+				modifiers: Modifiers::default(),
+				click_count: 1,
+			}),
+			cx,
+		);
+	})
+}
+
+async fn opened(shell: &Entity<Shell>, cx: &mut AsyncWindowContext, channel: Snowflake) -> anyhow::Result<()> {
+	until(cx, "the channel to open", |cx| {
+		shell.read_with(cx, |shell, cx| {
+			(shell.channel == Some(channel) && loaded(shell, channel, cx)).then_some(())
+		})
+	})
+	.await
+}
+
+async fn opened_dm(shell: &Entity<Shell>, cx: &mut AsyncWindowContext) -> anyhow::Result<()> {
+	until(cx, "a direct message to open", |cx| {
+		shell.read_with(cx, |shell, cx| {
+			let channel = shell.channel.filter(|_| shell.guild.is_none())?;
+			loaded(shell, channel, cx).then_some(())
+		})
+	})
+	.await
+}
+
+fn loaded(shell: &Shell, channel: Snowflake, cx: &gpui::App) -> bool {
+	shell
+		.data
+		.read(cx)
+		.state()
+		.messages(channel)
+		.is_some_and(|cache| !cache.ordered.is_empty())
+}
+
+fn last_message(shell: &Shell, channel: Snowflake, cx: &gpui::App) -> Option<Arc<Message>> {
+	let data = shell.data.read(cx);
+	let state = data.state();
+	state.messages(channel)?.ordered.last().cloned()
+}
+
+fn last_from_someone_else(shell: &Shell, channel: Snowflake, cx: &gpui::App) -> Option<Arc<Message>> {
+	let data = shell.data.read(cx);
+	let state = data.state();
+	let me = state.current_user_id();
+	state
+		.messages(channel)?
+		.ordered
+		.iter()
+		.rev()
+		.find(|message| Some(message.author.id) != me)
+		.cloned()
+}
+
+fn image_in(shell: &Shell, channel: Snowflake, cx: &gpui::App) -> Option<(Snowflake, ImageTarget)> {
+	let data = shell.data.read(cx);
+	let state = data.state();
+	state.messages(channel)?.ordered.iter().rev().find_map(|message| {
+		let attachment = message.attachments.iter().find(|attachment| {
+			attachment
+				.content_type
+				.as_deref()
+				.is_some_and(|kind| kind.starts_with("image/"))
+				&& attachment.width.is_some()
+		})?;
+		let url = attachment
+			.url
+			.clone()
+			.or_else(|| attachment.proxy_url.clone())?;
+		Some((
+			message.id,
+			ImageTarget {
+				url,
+				name: attachment.filename.clone(),
+				width: attachment.width.unwrap_or(0).max(1) as u32,
+				height: attachment.height.unwrap_or(0).max(1) as u32,
+			},
+		))
+	})
+}
+
+fn first_category(shell: &Shell, guild: Snowflake, cx: &gpui::App) -> Option<Snowflake> {
+	let data = shell.data.read(cx);
+	let state = data.state();
+	state
+		.guild_channel_tree(guild)
+		.into_iter()
+		.find_map(|node| node.category.map(|category| category.id))
+}
+
+fn forum_in(shell: &Shell, guild: Snowflake, cx: &gpui::App) -> Option<Snowflake> {
+	let data = shell.data.read(cx);
+	let state = data.state();
+	state
+		.guild_channel_tree(guild)
+		.into_iter()
+		.flat_map(|node| node.children)
+		.find(|row| !row.locked && row.kind == ChannelType::GuildForum)
+		.map(|row| row.id)
+}
+
+fn thread_of(shell: &Shell, parent: Snowflake, cx: &gpui::App) -> Option<Snowflake> {
+	let data = shell.data.read(cx);
+	let state = data.state();
+	let guild = state.channel_guild(parent)?;
+	let mut threads: Vec<Snowflake> = state
+		.guild(guild)?
+		.threads
+		.values()
+		.filter(|thread| thread.parent_id == Some(parent))
+		.map(|thread| thread.id)
+		.collect();
+	threads.sort();
+	threads.first().copied()
+}
+
+fn server_settings_page(screen: &str) -> Option<Page> {
+	Some(match screen.strip_prefix("server-settings-")? {
+		"overview" => Page::Overview,
+		"roles" => Page::Roles,
+		"emoji" => Page::Emoji,
+		"stickers" => Page::Stickers,
+		"members" => Page::Members,
+		"invites" => Page::Invites,
+		"bans" => Page::Bans,
+		"audit-log" => Page::AuditLog,
+		_ => return None,
+	})
+}
+
+const SHOWCASE_CHANNEL: &str = "showcase";
+const SHOWCASE_SECTIONS: [(&str, &str); 8] = [
+	("timeline-markdown", "showcase: markdown"),
+	("timeline-inline", "showcase: inline"),
+	("timeline-embeds", "showcase: embeds"),
+	("timeline-embeds-media", "showcase: embed media"),
+	("timeline-attachments", "showcase: attachments"),
+	("timeline-files", "showcase: files and stickers"),
+	("timeline-replies", "showcase: replies, polls and reactions"),
+	("timeline-system", "showcase: system messages"),
+];
+
+fn showcase_marker(screen: &str) -> Option<String> {
+	SHOWCASE_SECTIONS
+		.iter()
+		.find(|(name, _)| *name == screen)
+		.map(|(_, section)| format!("-# {section}"))
+}
+
+fn showcase_in(shell: &Shell, guild: Snowflake, cx: &gpui::App) -> Option<Snowflake> {
+	let data = shell.data.read(cx);
+	let state = data.state();
+	state
+		.guild_channel_tree(guild)
+		.into_iter()
+		.flat_map(|node| node.children)
+		.find(|row| state.channel(row.id).and_then(|channel| channel.name.as_deref()) == Some(SHOWCASE_CHANNEL))
+		.map(|row| row.id)
+}
+
+fn marked(shell: &Shell, channel: Snowflake, marker: &str, cx: &gpui::App) -> Option<Snowflake> {
+	let data = shell.data.read(cx);
+	let state = data.state();
+	state
+		.messages(channel)?
+		.ordered
+		.iter()
+		.find(|message| message.content == marker)
+		.map(|message| message.id)
+}
