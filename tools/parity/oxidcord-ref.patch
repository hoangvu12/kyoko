@@ -0,0 +1,644 @@
+use std::path::PathBuf;
+use std::sync::Arc;
+use std::time::{Duration, Instant};
+
+use anyhow::{Context as _, anyhow, bail};
+use gpui::{
+	Anchor, AsyncWindowContext, Context, Entity, Modifiers, MouseButton, MouseDownEvent, MouseMoveEvent,
+	MouseUpEvent, PlatformInput, Pixels, Point, ScrollDelta, ScrollWheelEvent, TouchPhase, WeakEntity, Window,
+	point, px,
+};
+use gpui_component::WindowExt as _;
+use gpui_component::notification::Notification;
+use protocol::{ChannelType, Message, Snowflake};
+use session::Command;
+
+use super::community::{ComposerSlot, PickerTarget};
+use super::friends::HomePage;
+use super::message::ImageTarget;
+use super::pickers::PickerTab;
+use super::server_settings::Page;
+use super::{Overlay, Shell};
+use crate::app::AppRoot;
+
+const POLL: Duration = Duration::from_millis(100);
+const SETTLE: Duration = Duration::from_millis(2000);
+const LIMIT: Duration = Duration::from_secs(30);
+const FAILED: i32 = 4;
+const LOGIN_PREFIX: &str = "login-";
+const SEARCH_QUERY: &str = "the";
+const DRAFT: &str = "Checking how the composer looks with a draft in it";
+const TOAST: &str = "You are sending messages too quickly.";
+
+const TOP_BAR_THREADS: (f32, f32) = (871., 46.);
+const TOP_BAR_PINS: (f32, f32) = (958., 46.);
+const COMPOSER_PICKER: (f32, f32) = (1001., 755.);
+const USER_PANEL_AVATAR: (f32, f32) = (99., 774.);
+const PROFILE_ANCHOR: (f32, f32) = (348., 404.);
+const LAST_MESSAGE: (f32, f32) = (640., 690.);
+const MEMBER_LIST: (f32, f32) = (1160., 450.);
+const FAR_SCROLL: f32 = 100_000.;
+
+pub struct Capture {
+	pub screen: String,
+	pub ready: PathBuf,
+}
+
+impl Capture {
+	pub fn wants_login(&self) -> bool {
+		self.screen.starts_with(LOGIN_PREFIX)
+	}
+}
+
+pub(crate) fn start(capture: Capture, window: &Window, cx: &mut Context<AppRoot>) {
+	cx.spawn_in(window, async move |root, cx| {
+		if let Err(error) = drive(&capture.screen, &root, cx).await {
+			tracing::error!(screen = %capture.screen, "capture steps failed: {error:#}");
+			std::process::exit(FAILED);
+		}
+		cx.background_executor().timer(SETTLE).await;
+		match std::fs::write(&capture.ready, std::process::id().to_string()) {
+			Ok(()) => tracing::info!(screen = %capture.screen, "capture screen ready"),
+			Err(error) => tracing::warn!(%error, "could not signal the capture screen"),
+		}
+	})
+	.detach();
+}
+
+async fn until<T>(
+	cx: &mut AsyncWindowContext,
+	what: &str,
+	mut probe: impl FnMut(&mut AsyncWindowContext) -> Option<T>,
+) -> anyhow::Result<T> {
+	let started = Instant::now();
+	loop {
+		if let Some(found) = probe(cx) {
+			return Ok(found);
+		}
+		if started.elapsed() >= LIMIT {
+			bail!("timed out waiting for {what}");
+		}
+		cx.background_executor().timer(POLL).await;
+	}
+}
+
+fn act<R>(
+	shell: &Entity<Shell>,
+	cx: &mut AsyncWindowContext,
+	step: impl FnOnce(&mut Shell, &mut Window, &mut Context<Shell>) -> anyhow::Result<R>,
+) -> anyhow::Result<R> {
+	shell.update_in(cx, step)?
+}
+
+fn at((x, y): (f32, f32)) -> Point<Pixels> {
+	point(px(x), px(y))
+}
+
+async fn drive(screen: &str, root: &WeakEntity<AppRoot>, cx: &mut AsyncWindowContext) -> anyhow::Result<()> {
+	if screen.starts_with(LOGIN_PREFIX) {
+		return drive_login(screen, root, cx).await;
+	}
+	let shell = until(cx, "the main view", |cx| {
+		root.read_with(cx, |root, _| root.shell()).ok().flatten()
+	})
+	.await?;
+	let first = until(cx, "the first channel", |cx| {
+		shell.read_with(cx, |shell, cx| shell.channel.filter(|channel| loaded(shell, *channel, cx)))
+	})
+	.await?;
+	match screen {
+		"app-frame" | "server-rail" | "channel-sidebar" | "timeline" | "member-list" | "user-panel" => {}
+		"server-rail-folder" => act(&shell, cx, |shell, _, cx| {
+			shell.rail.update(cx, |rail, cx| rail.open_all_folders(cx));
+			Ok(())
+		})?,
+		"channel-sidebar-collapsed" => act(&shell, cx, |shell, _, cx| {
+			let guild = shell.guild.context("no guild is open")?;
+			let category = first_category(shell, guild, cx).context("the guild has no category")?;
+			shell.send(
+				Command::ToggleCategory {
+					guild_id: guild,
+					category_id: category,
+				},
+				cx,
+			);
+			Ok(())
+		})?,
+		"dm-sidebar" => {
+			act(&shell, cx, |shell, window, cx| {
+				shell.show_home(window, cx);
+				Ok(())
+			})?;
+			opened_dm(&shell, cx).await?;
+		}
+		"dm-group" => {
+			let group = act(&shell, cx, |shell, _, cx| {
+				let group = shell
+					.data
+					.read(cx)
+					.state()
+					.dm_rows()
+					.into_iter()
+					.find(|row| row.recipients.len() > 1)
+					.map(|row| row.channel_id)
+					.context("no group DM in the fixtures")?;
+				shell.select(None, group, cx);
+				Ok(group)
+			})?;
+			opened(&shell, cx, group).await?;
+		}
+		"timeline-media" => act(&shell, cx, |shell, _, cx| {
+			let (message, _) = image_in(shell, first, cx).context("no image in the open channel")?;
+			shell.timeline.update(cx, |timeline, cx| timeline.jump_to(message, cx));
+			Ok(())
+		})?,
+		"member-list-scrolled" => {
+			until(cx, "the member list", |cx| {
+				shell.read_with(cx, |shell, cx| {
+					let guild = shell.guild?;
+					let rows = shell.data.read(cx).state().member_rows(guild).len();
+					(rows > 0).then_some(())
+				})
+			})
+			.await?;
+			cx.background_executor().timer(SETTLE).await;
+			scroll(cx, at(MEMBER_LIST), FAR_SCROLL)?;
+		}
+		"message-hover" => hover(cx, at(LAST_MESSAGE))?,
+		"message-context-menu" => {
+			hover(cx, at(LAST_MESSAGE))?;
+			click(cx, at(LAST_MESSAGE), MouseButton::Right)?;
+		}
+		"composer" | "composer-silent-typing" => act(&shell, cx, |shell, window, cx| {
+			shell
+				.composer
+				.update(cx, |composer, cx| composer.insert(DRAFT, window, cx));
+			Ok(())
+		})?,
+		"composer-reply" => act(&shell, cx, |shell, window, cx| {
+			let message = last_from_someone_else(shell, first, cx).context("no message to reply to")?;
+			shell.start_reply(message.id, window, cx);
+			Ok(())
+		})?,
+		"profile-popout" => act(&shell, cx, |shell, _, cx| {
+			let message = last_from_someone_else(shell, first, cx).context("no other author")?;
+			shell.open_profile(message.author.id, at(PROFILE_ANCHOR), Anchor::TopLeft, cx);
+			Ok(())
+		})?,
+		"full-profile" => act(&shell, cx, |shell, _, cx| {
+			let message = last_from_someone_else(shell, first, cx).context("no other author")?;
+			let guild = shell.guild;
+			shell
+				.account
+				.update(cx, |account, cx| account.open_full_profile(message.author.id, guild, cx));
+			Ok(())
+		})?,
+		"status-menu" => act(&shell, cx, |shell, _, cx| {
+			shell
+				.user_panel
+				.update(cx, |panel, cx| panel.toggle_menu(at(USER_PANEL_AVATAR), cx));
+			Ok(())
+		})?,
+		"account-switcher" => act(&shell, cx, |shell, _, cx| {
+			shell.user_panel.update(cx, |panel, cx| {
+				panel.toggle_menu(at(USER_PANEL_AVATAR), cx);
+				panel.show_accounts(cx);
+			});
+			Ok(())
+		})?,
+		"custom-status" => act(&shell, cx, |shell, window, cx| {
+			super::account::custom_status::open(shell.data.clone(), window, cx);
+			Ok(())
+		})?,
+		"quick-switcher" => act(&shell, cx, |shell, window, cx| {
+			shell.open_quick_switcher(window, cx);
+			Ok(())
+		})?,
+		"search" => act(&shell, cx, |shell, _, cx| {
+			shell.run_search(SEARCH_QUERY.to_owned(), cx);
+			Ok(())
+		})?,
+		"lightbox" => act(&shell, cx, |shell, _, cx| {
+			let (_, target) = image_in(shell, first, cx).context("no image in the open channel")?;
+			shell.overlay = Some(Overlay::Lightbox(target));
+			cx.notify();
+			Ok(())
+		})?,
+		"emoji-picker" => picker(&shell, cx, PickerTab::Emoji)?,
+		"gif-picker" => picker(&shell, cx, PickerTab::Gif)?,
+		"sticker-picker" => picker(&shell, cx, PickerTab::Sticker)?,
+		"threads-list" => act(&shell, cx, |shell, window, cx| {
+			shell
+				.community
+				.update(cx, |community, cx| community.open_threads(at(TOP_BAR_THREADS), window, cx));
+			Ok(())
+		})?,
+		"pins" => act(&shell, cx, |shell, window, cx| {
+			shell
+				.community
+				.update(cx, |community, cx| community.open_pins(at(TOP_BAR_PINS), window, cx));
+			Ok(())
+		})?,
+		"thread-panel" => {
+			let thread = act(&shell, cx, |shell, _, cx| {
+				let thread = thread_of(shell, first, cx).context("the open channel has no thread")?;
+				shell
+					.community
+					.update(cx, |community, cx| community.open_thread(thread, cx));
+				Ok(thread)
+			})?;
+			until(cx, "the thread history", |cx| {
+				shell.read_with(cx, |shell, cx| loaded(shell, thread, cx).then_some(()))
+			})
+			.await?;
+		}
+		"thread-create" => act(&shell, cx, |shell, window, cx| {
+			super::threads::create::open(window, cx, shell.data.clone(), first, None);
+			Ok(())
+		})?,
+		"forum" | "forum-post" | "forum-post-create" => {
+			let forum = act(&shell, cx, |shell, _, cx| {
+				let guild = shell.guild.context("no guild is open")?;
+				let forum = forum_in(shell, guild, cx).context("the guild has no forum")?;
+				shell.select(Some(guild), forum, cx);
+				Ok(forum)
+			})?;
+			until(cx, "the forum to open", |cx| {
+				shell.read_with(cx, |shell, _| (shell.channel == Some(forum)).then_some(()))
+			})
+			.await?;
+			match screen {
+				"forum-post" => {
+					let post = act(&shell, cx, |shell, _, cx| {
+						let post = thread_of(shell, forum, cx).context("the forum has no post")?;
+						shell
+							.community
+							.update(cx, |community, cx| community.open_thread(post, cx));
+						Ok(post)
+					})?;
+					until(cx, "the post history", |cx| {
+						shell.read_with(cx, |shell, cx| loaded(shell, post, cx).then_some(()))
+					})
+					.await?;
+				}
+				"forum-post-create" => act(&shell, cx, |shell, window, cx| {
+					super::threads::post::open(window, cx, shell.data.clone(), forum);
+					Ok(())
+				})?,
+				_ => {}
+			}
+		}
+		"friends-online" | "friends-all" | "friends-pending" | "friends-blocked" | "friends-add" => {
+			act(&shell, cx, |shell, window, cx| {
+				shell.show_home(window, cx);
+				Ok(())
+			})?;
+			opened_dm(&shell, cx).await?;
+			cx.background_executor().timer(SETTLE).await;
+			let tab = format!("friends-tab-{}", &screen["friends-".len()..]);
+			act(&shell, cx, |shell, _, cx| {
+				shell.home_pages.show(HomePage::Friends, cx);
+				let shown = shell
+					.home_pages
+					.friends
+					.update(cx, |friends, cx| friends.show_tab(&tab, cx));
+				if shown { Ok(()) } else { Err(anyhow!("no friends tab {tab}")) }
+			})?;
+		}
+		"add-server" => act(&shell, cx, |_, window, cx| {
+			super::community::add_server::open(window, cx);
+			Ok(())
+		})?,
+		"forward" => act(&shell, cx, |shell, window, cx| {
+			let message = last_message(shell, first, cx).context("no message to forward")?;
+			shell
+				.community
+				.update(cx, |community, cx| community.open_forward(first, message.id, window, cx));
+			Ok(())
+		})?,
+		"guild-notifications" => act(&shell, cx, |shell, window, cx| {
+			let guild = shell.guild.context("no guild is open")?;
+			super::community::notify::open_guild_modal(window, cx, guild);
+			Ok(())
+		})?,
+		"moderation-nickname" | "moderation-timeout" | "moderation-kick" | "moderation-ban" => {
+			act(&shell, cx, |shell, window, cx| {
+				let guild = shell.guild.context("no guild is open")?;
+				let message = last_from_someone_else(shell, first, cx).context("no other member")?;
+				let user = message.author.id;
+				let name = shell.data.read(cx).state().display_name(Some(guild), user);
+				use super::moderation::dialogs;
+				match screen {
+					"moderation-nickname" => dialogs::open_nickname(window, cx, guild, user, name),
+					"moderation-timeout" => dialogs::open_timeout(window, cx, guild, user, name),
+					"moderation-kick" => dialogs::open_kick(window, cx, guild, user, name),
+					_ => dialogs::open_ban(window, cx, guild, user, name),
+				}
+				Ok(())
+			})?
+		}
+		"toast" => act(&shell, cx, |_, window, cx| {
+			window.push_notification(Notification::error(TOAST), cx);
+			Ok(())
+		})?,
+		"connection-offline" => act(&shell, cx, |shell, _, cx| {
+			shell
+				.timeline
+				.update(cx, |timeline, cx| timeline.set_connected(false, cx));
+			Ok(())
+		})?,
+		other if showcase_marker(other).is_some() => {
+			let marker = showcase_marker(other).context("no showcase marker")?;
+			let channel = act(&shell, cx, |shell, _, cx| {
+				let guild = shell.guild.context("no guild is open")?;
+				let channel = showcase_in(shell, guild, cx).context("the guild has no showcase channel")?;
+				shell.select(Some(guild), channel, cx);
+				Ok(channel)
+			})?;
+			opened(&shell, cx, channel).await?;
+			let message = until(cx, "the showcase section", |cx| {
+				shell
+					.read_with(cx, |shell, cx| marked(shell, channel, &marker, cx))
+			})
+			.await?;
+			act(&shell, cx, |shell, _, cx| {
+				shell.timeline.update(cx, |timeline, cx| timeline.jump_to(message, cx));
+				Ok(())
+			})?;
+		}
+		other if other.starts_with("server-settings-") => {
+			let page = server_settings_page(other).with_context(|| format!("unknown page {other}"))?;
+			act(&shell, cx, |shell, window, cx| {
+				let guild = shell.guild.context("no guild is open")?;
+				shell.community.update(cx, |community, cx| {
+					community.open_server_settings(guild, Some(page), window, cx)
+				});
+				Ok(())
+			})?
+		}
+		other if other.starts_with("settings-") => act(&shell, cx, |shell, window, cx| {
+			shell.open_settings(window, cx);
+			let settings = shell.settings.clone().context("settings did not open")?;
+			if settings.update(cx, |settings, cx| settings.show_named(other, window, cx)) {
+				Ok(())
+			} else {
+				Err(anyhow!("no settings page {other}"))
+			}
+		})?,
+		other => bail!("no capture steps for {other}"),
+	}
+	Ok(())
+}
+
+async fn drive_login(screen: &str, root: &WeakEntity<AppRoot>, cx: &mut AsyncWindowContext) -> anyhow::Result<()> {
+	let login = until(cx, "the login screen", |cx| {
+		root.read_with(cx, |root, _| root.login()).ok().flatten()
+	})
+	.await?;
+	match screen {
+		"login-tos" => Ok(()),
+		"login-token" => {
+			login.update(cx, |login, cx| login.acknowledge(cx));
+			Ok(())
+		}
+		other => bail!("no capture steps for {other}"),
+	}
+}
+
+fn picker(shell: &Entity<Shell>, cx: &mut AsyncWindowContext, tab: PickerTab) -> anyhow::Result<()> {
+	act(shell, cx, |shell, window, cx| {
