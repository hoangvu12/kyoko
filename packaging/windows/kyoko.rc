1 ICON "@ICON@"

1 VERSIONINFO
FILEVERSION @VERSION_COMMA@
PRODUCTVERSION @VERSION_COMMA@
FILEFLAGSMASK 0x3f
FILEFLAGS 0x0
FILEOS 0x40004
FILETYPE 0x1
FILESUBTYPE 0x0
BEGIN
	BLOCK "StringFileInfo"
	BEGIN
		BLOCK "040904b0"
		BEGIN
			VALUE "CompanyName", "Kyoko"
			VALUE "FileDescription", "Kyoko"
			VALUE "FileVersion", "@VERSION@"
			VALUE "InternalName", "kyoko"
			VALUE "LegalCopyright", "MIT OR Apache-2.0"
			VALUE "OriginalFilename", "kyoko.exe"
			VALUE "ProductName", "Kyoko"
			VALUE "ProductVersion", "@VERSION@"
		END
	END
	BLOCK "VarFileInfo"
	BEGIN
		VALUE "Translation", 0x409, 1200
	END
END
